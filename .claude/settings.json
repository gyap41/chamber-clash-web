{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "Bash(powershell -ExecutionPolicy Bypass -File run_tests.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File run_tests.ps1 *)",
      "Bash(.local/tools/Godot_v4.7.2-stable_win64_console.exe --headless *)",
      "Bash(python tools/docs_index.py *)",
      "Bash(python tools/graphics_inventory.py --check *)",
      "Bash(.local/audio-venv/Scripts/python.exe tools/asset_check/*)",
      "Bash(.local/audio-venv/Scripts/python.exe tools/generate_image.py --check *)",
      "Bash(.local/audio-venv/Scripts/python.exe tools/generate_image.py --plan *)",
      "Bash(.local/audio-venv/Scripts/python.exe tools/asset_generator/asset.py check-keys)",
      "Bash(.local/audio-venv/Scripts/python.exe -m unittest *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./.local/backups/**)",
      "Read(./.local/md-audit-before/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/agent/session_start.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/agent/guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/agent/post_edit.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"",
            "timeout": 90,
            "statusMessage": "Checking edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/agent/stop_check.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"",
            "timeout": 300,
            "statusMessage": "Checking changed .gd files"
          }
        ]
      }
    ]
  }
}
