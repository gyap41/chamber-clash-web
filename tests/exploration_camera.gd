extends SceneTree
const Follow = preload("res://scripts/visuals/exploration_camera.gd")
func _initialize() -> void: call_deferred("run")
func run() -> void:
	root.size = Vector2i(1120,800)
	assert(Follow.origin(Rect2(0,0,1120,600),Vector2(1000,450)) == Vector2(0,-90))
	assert(Follow.origin(Rect2(100,200,560,300),Vector2(120,220)) == Vector2(-180,-40))
	assert(Follow.origin(Rect2(0,0,2240,1200),Vector2(1120,600)) == Vector2(560,210))
	assert(Follow.origin(Rect2(0,0,2240,1200),Vector2(20,20)) == Vector2(0,-90))
	assert(Follow.origin(Rect2(0,0,2240,1200),Vector2(2200,1180)) == Vector2(1120,510))
	assert(Follow.origin(Rect2(0,0,560,1200),Vector2(280,600)) == Vector2(-280,210))
	var game = load("res://scenes/game/exploration.tscn").instantiate()
	root.add_child(game)
	game.set_physics_process(false)
	game.set_pause_reason("focus",false)
	var camera: Camera2D = game.arena.get_node("CombatCamera")
	assert(camera.zoom == Vector2.ONE and camera.position == Vector2(0,-90))
	var large = preload("res://scripts/world/field_definition.gd").new()
	large.field_id = "camera-test"
	large.field_rect = Rect2(0,0,2240,1200)
	large.fighter_bounds = Rect2(14,14,2212,1172)
	large.projectile_bounds = large.field_rect
	large.spawns = PackedVector2Array([Vector2(1120,600)])
	assert(game.switch_field(large).is_empty())
	assert(camera.zoom == Vector2.ONE and camera.position == Vector2(560,210))
	var screen_point: Vector2 = game.arena.get_canvas_transform()*game.arena.to_global(Vector2(1120,600))
	assert(screen_point.is_equal_approx(Vector2(560,390)))
	assert((game.arena.get_canvas_transform().affine_inverse()*screen_point).is_equal_approx(game.arena.to_global(Vector2(1120,600))))
	game.command_source = func(_i,_dt): return game.Command.idle(0)
	game.players[0].state.pos = Vector2(1800,900)
	game._physics_process(0)
	assert(camera.position == Vector2(1120,510))
	game.set_pause_reason("menu",true)
	game.players[0].state.pos = Vector2(500,300)
	game._physics_process(0)
	assert(camera.position == Vector2(1120,510))
	game.set_pause_reason("menu",false)
	game._physics_process(0)
	assert(camera.position == Vector2(0,-90))
	game.start_exploration(1)
	assert(camera.position == Vector2(0,-90) and camera.offset == Vector2.ZERO)
	game.queue_free()
	await process_frame
	print("PASS: fixed scale, small room centering, large room tracking/limits, narrow room, pause and transition snap")
	quit()
